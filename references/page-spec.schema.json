{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/helloo1568/image-ppt/references/page-spec.schema.json",
  "title": "image-ppt Page Spec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "title",
    "content_approved",
    "content_version",
    "content_authorization",
    "canvas",
    "style",
    "slides"
  ],
  "properties": {
    "version": {"const": "1.0"},
    "title": {"type": "string", "minLength": 1},
    "content_approved": {"const": true},
    "content_version": {"type": "string", "minLength": 1},
    "content_authorization": {"type": "string", "minLength": 1},
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": {"type": "number", "exclusiveMinimum": 0},
        "height": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "authorization", "visual_spec"],
      "properties": {
        "decision": {
          "enum": ["selected", "locked-reference", "skipped", "delegated"]
        },
        "choice": {"type": "string"},
        "authorization": {"type": "string", "minLength": 1},
        "visual_spec": {"type": "string", "minLength": 1}
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/slide"}
    }
  },
  "$defs": {
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "page_number",
        "title",
        "core_message",
        "visual_brief",
        "image_file",
        "image_status",
        "elements"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "page_number": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1},
        "core_message": {"type": "string", "minLength": 1},
        "visual_brief": {"type": "string", "minLength": 1},
        "source_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "image_file": {
          "type": "string",
          "pattern": "\\.(?:[Pp][Nn][Gg]|[Jj][Pp][Ee]?[Gg])$"
        },
        "image_status": {
          "enum": ["pending", "generated", "revision", "approved"]
        },
        "generation_prompt": {"type": "string"},
        "elements": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/element"}
        },
        "notes": {"type": "string"}
      }
    },
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "role",
        "native_intent",
        "source_ref",
        "confirmation_status"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {
          "enum": ["text", "image", "shape", "line", "table", "chart"]
        },
        "role": {"type": "string", "minLength": 1},
        "native_intent": {"enum": ["native", "raster", "either"]},
        "source_ref": {"type": "string", "minLength": 1},
        "confirmation_status": {
          "enum": ["confirmed", "source-verified", "unresolved"]
        },
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "text": {"type": "string"},
        "data": {
          "type": ["object", "array"],
          "minProperties": 1,
          "minItems": 1
        },
        "visual_brief": {"type": "string"},
        "bbox_hint": {
          "type": "array",
          "prefixItems": [
            {"type": "number", "minimum": 0},
            {"type": "number", "minimum": 0},
            {"type": "number", "exclusiveMinimum": 0},
            {"type": "number", "exclusiveMinimum": 0}
          ],
          "minItems": 4,
          "maxItems": 4
        },
        "z_hint": {"type": "integer"},
        "separate_asset": {"type": "boolean"},
        "prompt_record": {"type": "string"},
        "notes": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "text"}}},
          "then": {"required": ["text"]}
        },
        {
          "if": {"properties": {"kind": {"enum": ["table", "chart"]}}},
          "then": {"required": ["data"]}
        },
        {
          "if": {"properties": {"kind": {"const": "image"}}},
          "then": {"required": ["visual_brief", "separate_asset"]}
        },
        {
          "if": {
            "properties": {"confirmation_status": {"const": "unresolved"}}
          },
          "then": {"required": ["confidence"]}
        }
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    }
  }
}
