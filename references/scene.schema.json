{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "image-ppt editable scene v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "canvas",
    "slides"
  ],
  "properties": {
    "version": {
      "const": "1.0"
    },
    "title": {
      "type": "string"
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "width_inches": {
          "type": "number",
          "minimum": 1,
          "maximum": 56
        }
      }
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "elements"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "title": {
            "type": "string"
          },
          "source_image": {
            "type": "string"
          },
          "background": {
            "$ref": "#/$defs/color"
          },
          "notes": {
            "type": "string"
          },
          "elements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/element"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "nullableColor": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/color"
        }
      ]
    },
    "element": {
      "oneOf": [
