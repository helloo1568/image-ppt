          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
            },
            "name": {
              "type": "string"
            },
            "type": {
              "const": "text"
            },
            "source": {
              "type": "string"
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "note": {
              "type": "string"
            },
            "x": {
              "type": "number",
              "minimum": 0
            },
            "y": {
              "type": "number",
              "minimum": 0
            },
            "w": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "h": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "rotation": {
              "type": "number",
              "minimum": -360,
              "maximum": 360
            },
            "text": {
              "type": "string"
            },
            "font": {
              "type": "string",
              "minLength": 1
            },
            "font_size": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "color": {
              "$ref": "#/$defs/color"
            },
            "bold": {
              "type": "boolean"
            },
            "italic": {
              "type": "boolean"
            },
            "align": {
              "enum": [
                "left",
                "center",
                "right"
              ]
            },
            "valign": {
              "enum": [
                "top",
                "middle",
                "bottom"
              ]
            },
            "margin": {
              "type": "number",
              "minimum": 0
            },
            "line_spacing": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "id",
            "type",
            "x",
            "y",
            "w",
            "h",
            "text"
